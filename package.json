{
  "name": "zatca",
  "version": "2.0.0-dev.0",
  "private": true,
  "description": "Node.js QR code generator and portable encoding utilities for ZATCA e-invoicing",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "browser": null,
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./qr": {
      "import": {
        "types": "./dist/qr.d.mts",
        "default": "./dist/qr.mjs"
      },
      "require": {
        "types": "./dist/qr.d.cts",
        "default": "./dist/qr.cjs"
      }
    },
    "./qr/render": {
      "import": {
        "types": "./dist/render.d.mts",
        "default": "./dist/render.mjs"
      },
      "require": {
        "types": "./dist/render.d.cts",
        "default": "./dist/render.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "clean": "node --eval \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "npm run clean && tsdown",
    "lint": "biome lint .",
    "format:check": "biome format .",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.qr.json",
    "test": "vitest run && npm run test:legacy",
    "test:legacy": "node --test tests/legacy-compatibility.test.cjs",
    "test:coverage": "vitest run --coverage",
    "test:consumers": "node scripts/verify-package.mjs --consumers-only",
    "package:verify": "node scripts/verify-package.mjs",
    "audit:dependencies": "npm audit --audit-level=moderate",
    "audit:licenses": "node scripts/verify-licenses.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/abdo-host/ZATCA-JS.git"
  },
  "keywords": [
    "ZATCA",
    "e-invoicing",
    "qr-code",
    "TLV"
  ],
  "author": "Tatwerat <tatwerat@gmail.com>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/abdo-host/ZATCA-JS/issues"
  },
  "homepage": "https://github.com/abdo-host/ZATCA-JS#readme",
  "dependencies": {
    "qrcode": "1.5.4"
  },
  "peerDependencies": {
    "@types/node": ">=22"
  },
  "peerDependenciesMeta": {
    "@types/node": {
      "optional": true
    }
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@biomejs/biome": "2.6.4",
    "@resvg/resvg-js": "2.6.2",
    "@types/node": "22.20.5",
    "@types/pngjs": "6.0.5",
    "@types/qrcode": "1.5.6",
    "@vitest/coverage-v8": "4.1.12",
    "fast-check": "4.10.2",
    "jsqr": "1.4.0",
    "pngjs": "7.0.0",
    "publint": "0.3.25",
    "saxes": "6.0.0",
    "tsdown": "0.23.4",
    "typescript": "5.9.3",
    "vite": "8.3.5",
    "vitest": "4.1.12",
    "xmlbuilder2": "4.0.3",
    "zod": "4.6.7"
  }
}
