{
  "files": {
    "includes": [
      "*.json",
      "*.ts",
      "scripts/**",
      "demo/**/*.ts",
      "src/**",
      "tests/**",
      "!package-lock.json",
      "!tests/fixtures"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "lineEnding": "lf"
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single"
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended"
    }
  }
}
